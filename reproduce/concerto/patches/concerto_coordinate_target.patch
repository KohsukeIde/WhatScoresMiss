+"""Sanitized patch excerpt for the coordinate-only target diagnostic.
+
+The control fits a two-layer MLP from pooled XYZ statistics to Concerto pretext
+targets and evaluates the fraction of target-swap response closed by that
+coordinate-only prediction.
+"""
+
+class CoordinateOnlyMLP(nn.Module):
+    def __init__(self, in_dim=6, hidden_dim=256, out_dim=None):
+        super().__init__()
+        self.net = nn.Sequential(
+            nn.Linear(in_dim, hidden_dim),
+            nn.ReLU(inplace=True),
+            nn.Linear(hidden_dim, out_dim),
+        )
+
+    def forward(self, xyz):
+        pooled = torch.cat([xyz.mean(dim=1), xyz.std(dim=1)], dim=-1)
+        return self.net(pooled)
+
+def coordinate_target_loss(model, xyz, target, criterion):
+    pred = model(xyz)
+    return criterion(pred, target)
